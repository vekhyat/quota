# Maintainer: Vekhyat Jain <vekhyatjain123 at gmail dot com>
pkgname=quota
pkgver=0.4.0
pkgrel=1
pkgdesc='Show Claude, Codex, and Grok limits, usage, and cost'
arch=('x86_64' 'aarch64')
url='https://github.com/vekhyat/quota'
license=('MIT')
depends=('qt6-base>=6.4' 'qt6-declarative>=6.4' 'qt6-wayland' 'gcc-libs' 'glibc')
# Both packages install /usr/bin/quota.
conflicts=('quota-tools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6538806191883b314f1ec18bc2b2b8adfc253fc0c2443cb5d0d9f400e263ed5d')

build() {
  cd "$pkgname-$pkgver"
  mkdir -p build
  cd build
  qmake6 ../quota.pro
  make
}

check() {
  cd "$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/quota "$pkgdir/usr/bin/quota"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/quota.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quota.svg"
  install -Dm644 pkgbuild/quota.desktop "$pkgdir/usr/share/applications/quota.desktop"
}
