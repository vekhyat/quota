pkgname=quota
pkgver=0.1.0
pkgrel=1
pkgdesc='Show limits, usage, and cost'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/quota "$pkgdir/usr/bin/quota"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/quota.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/quota.svg"
  install -Dm644 "$startdir/quota.desktop" "$pkgdir/usr/share/applications/quota.desktop"
}
